# Copy thành .env và điền giá trị thật
# ❌ KHÔNG BAO GIỜ commit file .env lên Git

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=false

# App
APP_NAME=Legal Compliance Agent
APP_VERSION=1.0.0

# Vertex AI
VERTEX_PROJECT=vinuni-project
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash

# Vertex AI credentials — paste toàn bộ nội dung vertex-key.json vào đây (1 dòng)
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Security — BẮT BUỘC thay trong production
AGENT_API_KEY=dev-key-change-me-in-production

# Rate & Budget
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=5.0

# CORS
ALLOWED_ORIGINS=*
